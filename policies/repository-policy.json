{
  "schemaVersion": 1,
  "forbiddenTrackedSuffixes": [
    ".auto.tfvars",
    ".auto.tfvars.json",
    ".kubeconfig",
    ".tfplan",
    ".tfstate"
  ],
  "forbiddenTrackedNames": [
    ".env",
    "install-config.yaml",
    "kubeadmin-password",
    "kubeconfig",
    "metadata.json",
    "pull-secret.json",
    "terraform.tfvars"
  ],
  "forbiddenContentPatterns": [
    "-----BEGIN PRIVATE KEY-----",
    "-----BEGIN OPENSSH PRIVATE KEY-----",
    "AIza[0-9A-Za-z_-]{30,}",
    "ghp_[0-9A-Za-z]{30,}",
    "github_pat_[0-9A-Za-z_]{30,}"
  ],
  "allowedSecretPlaceholders": [
    "${PULL_SECRET_JSON}",
    "${SSH_PUBLIC_KEY}"
  ],
  "requiredClaim": {
    "referenceProfileVerified": false,
    "customerCertified": false,
    "redHatCertified": false,
    "contractualSla": false
  }
}
