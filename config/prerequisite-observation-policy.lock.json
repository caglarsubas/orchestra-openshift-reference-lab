    "openshiftPullSecret": {
      "stage": "bootstrap",
      "evidenceClass": "restricted-secret-read",
      "requiredChecks": ["required-registry-auths"],
      "independentReviewRequired": true
    },
    "openshiftInstaller": {
      "stage": "bootstrap",
      "evidenceClass": "local-binary-and-official-digest",
      "requiredChecks": ["exact-installer"],
      "independentReviewRequired": true
    },
    "gcpBillingAndQuotas": {
      "stage": "foundation",
      "evidenceClass": "gcp-read-only-api",
      "requiredChecks": ["billing-and-capacity"],
      "independentReviewRequired": true
    },
    "targetProject": {
      "stage": "foundation",
      "evidenceClass": "gcp-read-only-api",
      "requiredChecks": ["dedicated-target-project"],
      "independentReviewRequired": true
    },
    "servicesEvidenceProject": {
      "stage": "foundation",
      "evidenceClass": "gcp-read-only-api",
      "requiredChecks": ["dedicated-services-project"],
      "independentReviewRequired": true
    },
    "dnsDelegation": {
      "stage": "openshift-install",
      "evidenceClass": "gcp-dns-and-public-delegation",
      "requiredChecks": ["exact-public-delegation"],
      "independentReviewRequired": true
    },
    "shortLivedIdentityFederation": {
      "stage": "foundation",
      "evidenceClass": "gcp-iam-read-only-api",
      "requiredChecks": ["restricted-wif-no-user-keys"],
      "independentReviewRequired": true
    },
    "certificationRunner": {
      "stage": "bootstrap",
      "evidenceClass": "sigstore-registry-verification",
      "requiredChecks": ["signed-runner-provenance"],
      "independentReviewRequired": true
    },
    "crossPlaneReleaseSet": {
      "stage": "bootstrap",
      "evidenceClass": "canonical-repository-contract",
      "requiredChecks": ["locked-release-set"],
      "independentReviewRequired": true
    }
  },
