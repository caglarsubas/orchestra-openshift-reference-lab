{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prometa.ai/orchestra/reference-lab/sno-trial-product-artifact-replay-v1.schema.json",
  "title": "Orchestra OpenShift SNO trial product artifact replay v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "verificationId",
    "generatedAt",
    "targetClass",
    "executionMode",
    "bindings",
    "publication",
    "image",
    "chart",
    "admission",
    "activation",
    "controls",
    "claims",
    "reportDigest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {
      "const": "orchestra.openshift.sno-trial-product-artifact-replay.v1"
    },
    "verificationId": {
      "type": "string",
      "pattern": "^sno-product-replay-[a-z0-9][a-z0-9.-]{5,79}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "targetClass": {"const": "engineering-trial"},
    "executionMode": {"const": "live-public-artifact-replay"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "publication": {"$ref": "#/$defs/publication"},
    "image": {"$ref": "#/$defs/image"},
    "chart": {"$ref": "#/$defs/chart"},
    "admission": {"$ref": "#/$defs/admission"},
    "activation": {"$ref": "#/$defs/activation"},
    "controls": {"$ref": "#/$defs/controls"},
    "claims": {"$ref": "#/$defs/claims"},
    "reportDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "artifactSetId",
        "artifactSetDigest",
        "workloadCandidateDigest",
        "verifierRevision",
        "verifierRunId",
        "verifierRunAttempt"
      ],
      "properties": {
        "profileId": {"const": "orchestra-ocp-sno-trial-amd64-v1"},
        "artifactSetId": {
          "const": "orchestra-sno-trial-products-2026-07-25.1"
        },
        "artifactSetDigest": {"$ref": "#/$defs/digest"},
        "workloadCandidateDigest": {"$ref": "#/$defs/digest"},
        "verifierRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "verifierRunId": {"type": "integer", "minimum": 1},
        "verifierRunAttempt": {"const": 1}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runId",
        "runAttempt",
        "runUrl",
        "tag",
        "sourceRevision",
        "workflow",
        "workflowName",
        "conclusion"
      ],
      "properties": {
        "runId": {"const": 30151836099},
        "runAttempt": {"const": 1},
        "runUrl": {
          "const": "https://github.com/caglarsubas/llm_inference_engine/actions/runs/30151836099"
        },
        "tag": {"const": "v0.1.11"},
        "sourceRevision": {
          "const": "6c3f2a0cb34ca5110760b53d9cc8d65a3a5c2df2"
        },
        "workflow": {"const": ".github/workflows/publish-images.yml"},
        "workflowName": {"const": "publish-release-artifacts"},
        "conclusion": {"const": "success"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest",
        "reference",
        "platform",
        "platformManifestDigest",
        "variant",
        "platformManifestVerified",
        "signatureVerified",
        "cycloneDxAttestationVerified"
      ],
      "properties": {
        "repository": {
          "const": "ghcr.io/caglarsubas/llm_inference_engine/inference-engine-ubi"
        },
        "digest": {"$ref": "#/$defs/digest"},
        "reference": {
          "type": "string",
          "pattern": "^ghcr\\.io/caglarsubas/llm_inference_engine/inference-engine-ubi@sha256:[a-f0-9]{64}$"
        },
        "platform": {"const": "linux/amd64"},
        "platformManifestDigest": {"$ref": "#/$defs/digest"},
        "variant": {"const": "ubi9"},
        "platformManifestVerified": {"const": true},
        "signatureVerified": {"const": true},
        "cycloneDxAttestationVerified": {"const": true}
      }
    },
    "chart": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference",
        "digest",
        "name",
        "version",
        "appVersion",
        "packageDigest",
        "trialValuesPath",
        "trialValuesDigest",
        "signatureVerified",
        "cycloneDxAttestationVerified",
        "packagePulled",
        "trialValuesVerified"
      ],
      "properties": {
        "reference": {
          "type": "string",
          "pattern": "^ghcr\\.io/caglarsubas/llm_inference_engine/charts/orchestra-inference-engine@sha256:[a-f0-9]{64}$"
        },
        "digest": {"$ref": "#/$defs/digest"},
        "name": {"const": "orchestra-inference-engine"},
        "version": {"const": "0.1.3"},
        "appVersion": {"const": "0.1.11"},
        "packageDigest": {"$ref": "#/$defs/digest"},
        "trialValuesPath": {
          "const": "orchestra-inference-engine/values.openshift-sno-trial.yaml"
        },
        "trialValuesDigest": {"$ref": "#/$defs/digest"},
        "signatureVerified": {"const": true},
        "cycloneDxAttestationVerified": {"const": true},
        "packagePulled": {"const": true},
        "trialValuesVerified": {"const": true}
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "sourceOnly",
        "publicReplayRequired",
        "destinationMirrorVerified",
        "liveClusterPullVerified",
        "secretReferencesResolved",
        "serverSideDryRunVerified",
        "activationAuthorized"
      ],
      "properties": {
        "state": {"const": "published-not-trial-admitted"},
        "sourceOnly": {"const": true},
        "publicReplayRequired": {"const": true},
        "destinationMirrorVerified": {"const": false},
        "liveClusterPullVerified": {"const": false},
        "secretReferencesResolved": {"const": false},
        "serverSideDryRunVerified": {"const": false},
        "activationAuthorized": {"const": false}
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasonCodes"],
      "properties": {
        "state": {"const": "blocked"},
        "reasonCodes": {
          "type": "array",
          "prefixItems": [
            {"const": "platform-sno-profile-missing"},
            {"const": "runtime-sno-profile-missing"},
            {"const": "product-artifact-replay-review-missing"},
            {"const": "destination-mirror-verification-missing"},
            {"const": "live-cluster-pull-verification-missing"},
            {"const": "operator-secret-and-ca-inputs-missing"},
            {"const": "openshift-server-side-dry-run-missing"},
            {"const": "provider-readiness-not-approved"}
          ],
          "items": false,
          "minItems": 8,
          "maxItems": 8
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registryReadOnly",
        "registryCredentialsRequired",
        "githubApiTokenUsed",
        "providerCredentialsUsed",
        "payloadsCollected",
        "secretsCollected",
        "manifestsEmitted",
        "cloudMutationAuthorized",
        "deploymentAuthorized",
        "campaignEligible",
        "allowedCertificationSlots"
      ],
      "properties": {
        "registryReadOnly": {"const": true},
        "registryCredentialsRequired": {"const": false},
        "githubApiTokenUsed": {"const": true},
        "providerCredentialsUsed": {"const": false},
        "payloadsCollected": {"const": false},
        "secretsCollected": {"const": false},
        "manifestsEmitted": {"const": false},
        "cloudMutationAuthorized": {"const": false},
        "deploymentAuthorized": {"const": false},
        "campaignEligible": {"const": false},
        "allowedCertificationSlots": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaignEvidence",
        "referenceProfileVerified",
        "customerCertified",
        "redHatCertified",
        "contractualSla",
        "productionSupported"
      ],
      "properties": {
        "campaignEvidence": {"const": false},
        "referenceProfileVerified": {"const": false},
        "customerCertified": {"const": false},
        "redHatCertified": {"const": false},
        "contractualSla": {"const": false},
        "productionSupported": {"const": false}
      }
    }
  }
}
