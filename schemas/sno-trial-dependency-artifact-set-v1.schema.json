{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prometa.ai/orchestra/reference-lab/sno-trial-dependency-artifact-set-v1.schema.json",
  "title": "Orchestra OpenShift SNO trial dependency artifact set v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "artifactSetId",
    "profileId",
    "targetClass",
    "executionMode",
    "architecture",
    "bindings",
    "containers",
    "models",
    "runtimeBinding",
    "activation",
    "controls",
    "claims",
    "artifactSetDigest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {
      "const": "orchestra.openshift.sno-trial-dependency-artifact-set.v1"
    },
    "artifactSetId": {
      "const": "orchestra-sno-trial-dependency-artifacts-2026-07-28.1"
    },
    "profileId": {"const": "orchestra-ocp-sno-trial-amd64-v1"},
    "targetClass": {"const": "engineering-trial"},
    "executionMode": {"const": "source-only"},
    "architecture": {"const": "linux/amd64"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "containers": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"$ref": "#/$defs/valkeyContainer"},
        {"$ref": "#/$defs/modelBackendContainer"}
      ],
      "items": false
    },
    "models": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "prefixItems": [
        {"$ref": "#/$defs/model"}
      ],
      "items": false
    },
    "runtimeBinding": {"$ref": "#/$defs/runtimeBinding"},
    "activation": {"$ref": "#/$defs/activation"},
    "controls": {"$ref": "#/$defs/controls"},
    "claims": {"$ref": "#/$defs/claims"},
    "artifactSetDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dependencyBomDigest",
        "dependencyAdmissionDigest",
        "runtimeContractSetDigest"
      ],
      "properties": {
        "dependencyBomDigest": {"$ref": "#/$defs/digest"},
        "dependencyAdmissionDigest": {"$ref": "#/$defs/digest"},
        "runtimeContractSetDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "upstreamVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "method", "identityPolicy"],
      "properties": {
        "status": {"const": "pending"},
        "method": {"const": "reviewed-exception"},
        "identityPolicy": {"type": "null"}
      }
    },
    "runtimeCompatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arbitraryUidRequired",
        "fixedUidAllowed",
        "readOnlyRootFilesystemRequired",
        "serviceAccountTokenAutomount",
        "requiredWritablePaths"
      ],
      "properties": {
        "arbitraryUidRequired": {"const": true},
        "fixedUidAllowed": {"const": false},
        "readOnlyRootFilesystemRequired": {"const": true},
        "serviceAccountTokenAutomount": {"const": false},
        "requiredWritablePaths": {
          "type": "array",
          "maxItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["/data"]}
        }
      }
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "serviceId",
        "sourceReference",
        "resolvedReference",
        "indexDigest",
        "platformDigest",
        "platform",
        "version",
        "sourceRevision",
        "sourceUrl",
        "license",
        "upstreamVerification",
        "runtimeCompatibility"
      ],
      "properties": {
        "id": {"enum": ["valkey-image", "model-backend-image"]},
        "serviceId": {"enum": ["valkey", "model-backend"]},
        "sourceReference": {"type": "string", "minLength": 1},
        "resolvedReference": {
          "type": "string",
          "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$"
        },
        "indexDigest": {"$ref": "#/$defs/digest"},
        "platformDigest": {"$ref": "#/$defs/digest"},
        "platform": {"const": "linux/amd64"},
        "version": {"type": "string", "minLength": 1},
        "sourceRevision": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{40}$"
        },
        "sourceUrl": {
          "type": "string",
          "pattern": "^https://github\\.com/"
        },
        "license": {"enum": ["BSD-3-Clause", "MIT"]},
        "upstreamVerification": {
          "$ref": "#/$defs/upstreamVerification"
        },
        "runtimeCompatibility": {
          "$ref": "#/$defs/runtimeCompatibility"
        }
      }
    },
    "valkeyContainer": {
      "allOf": [
        {"$ref": "#/$defs/container"},
        {
          "type": "object",
          "properties": {
            "id": {"const": "valkey-image"},
            "serviceId": {"const": "valkey"},
            "version": {"const": "9.1.0"},
            "sourceRevision": {"type": "null"},
            "license": {"const": "BSD-3-Clause"}
          }
        }
      ]
    },
    "modelBackendContainer": {
      "allOf": [
        {"$ref": "#/$defs/container"},
        {
          "type": "object",
          "properties": {
            "id": {"const": "model-backend-image"},
            "serviceId": {"const": "model-backend"},
            "version": {"const": "b10143"},
            "sourceRevision": {
              "const": "88b47a755c72fed4b22fba0fd262e2d7b7d01583"
            },
            "license": {"const": "MIT"}
          }
        }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "serviceId",
        "provider",
        "repository",
        "revision",
        "filename",
        "immutableUrl",
        "digest",
        "sizeBytes",
        "format",
        "quantization",
        "license",
        "servedModelId",
        "mountPath",
        "materialization",
        "runtimeDownloadAllowed",
        "maximumAllowedBytes",
        "chatRequired",
        "embeddingQualityCertifying"
      ],
      "properties": {
        "id": {"const": "orchestra-reference-cpu-model"},
        "serviceId": {"const": "model-backend"},
        "provider": {"const": "Qwen"},
        "repository": {"const": "Qwen/Qwen2.5-0.5B-Instruct-GGUF"},
        "revision": {
          "const": "9217f5db79a29953eb74d5343926648285ec7e67"
        },
        "filename": {
          "const": "qwen2.5-0.5b-instruct-q4_k_m.gguf"
        },
        "immutableUrl": {
          "type": "string",
          "pattern": "^https://huggingface\\.co/Qwen/Qwen2\\.5-0\\.5B-Instruct-GGUF/resolve/9217f5db79a29953eb74d5343926648285ec7e67/"
        },
        "digest": {"$ref": "#/$defs/digest"},
        "sizeBytes": {"const": 491400032},
        "format": {"const": "gguf"},
        "quantization": {"const": "Q4_K_M"},
        "license": {"const": "Apache-2.0"},
        "servedModelId": {"const": "orchestra-reference-cpu"},
        "mountPath": {
          "const": "/models/qwen2.5-0.5b-instruct-q4_k_m.gguf"
        },
        "materialization": {
          "const": "operator-prestaged-read-only-pvc"
        },
        "runtimeDownloadAllowed": {"const": false},
        "maximumAllowedBytes": {"const": 4294967296},
        "chatRequired": {"const": true},
        "embeddingQualityCertifying": {"const": false}
      }
    },
    "runtimeBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "containerId",
        "modelId",
        "protocol",
        "port",
        "authentication",
        "tls",
        "healthPath",
        "modelInventoryPath",
        "startupArguments"
      ],
      "properties": {
        "containerId": {"const": "model-backend-image"},
        "modelId": {"const": "orchestra-reference-cpu-model"},
        "protocol": {"const": "openai-compatible-https"},
        "port": {"const": 8000},
        "authentication": {"const": "api-key-file"},
        "tls": {"const": "operator-secret-files"},
        "healthPath": {"const": "/health"},
        "modelInventoryPath": {"const": "/v1/models"},
        "startupArguments": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reasonCodes"],
      "properties": {
        "state": {"const": "blocked"},
        "reasonCodes": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "enum": [
              "UPSTREAM_VERIFICATION_PENDING",
              "DESTINATION_MIRROR_PROOF_MISSING",
              "LAB_SIGNATURE_MISSING",
              "MODEL_PVC_MATERIALIZATION_PROOF_MISSING",
              "DEPENDENCY_SECRET_REFERENCES_UNRESOLVED",
              "DEPENDENCY_TLS_REFERENCES_UNRESOLVED",
              "STORAGE_CLASS_REFERENCE_UNRESOLVED",
              "OPENSHIFT_SERVER_SIDE_DRY_RUN_MISSING",
              "LIVE_DEPENDENCY_CONNECTIVITY_MISSING"
            ]
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "sourceOnly",
        "artifactBytesStored",
        "productionDependencyProfileMutated",
        "workloadCandidateMutated",
        "manifestsEmitted",
        "argocdApplicationsEmitted",
        "kustomizationReferenced",
        "secretValuesStored",
        "runtimeModelDownloadAllowed",
        "cloudMutationAuthorized",
        "deploymentAuthorized",
        "campaignEligible",
        "allowedCertificationSlots"
      ],
      "properties": {
        "scope": {
          "const": "sno-engineering-trial-dependency-artifacts-only"
        },
        "sourceOnly": {"const": true},
        "artifactBytesStored": {"const": false},
        "productionDependencyProfileMutated": {"const": false},
        "workloadCandidateMutated": {"const": false},
        "manifestsEmitted": {"const": false},
        "argocdApplicationsEmitted": {"const": false},
        "kustomizationReferenced": {"const": false},
        "secretValuesStored": {"const": false},
        "runtimeModelDownloadAllowed": {"const": false},
        "cloudMutationAuthorized": {"const": false},
        "deploymentAuthorized": {"const": false},
        "campaignEligible": {"const": false},
        "allowedCertificationSlots": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaignEvidence",
        "referenceProfileVerified",
        "customerCertified",
        "redHatCertified",
        "contractualSla",
        "productionSupported",
        "highAvailability",
        "rpoRtoVerified"
      ],
      "properties": {
        "campaignEvidence": {"const": false},
        "referenceProfileVerified": {"const": false},
        "customerCertified": {"const": false},
        "redHatCertified": {"const": false},
        "contractualSla": {"const": false},
        "productionSupported": {"const": false},
        "highAvailability": {"const": false},
        "rpoRtoVerified": {"const": false}
      }
    }
  }
}
