{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prometa.ai/orchestra/sno-trial-dependency-risk-evidence-v1.schema.json",
  "title": "Orchestra SNO trial dependency risk evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "evidenceId",
    "profileId",
    "targetClass",
    "executionMode",
    "bindings",
    "collection",
    "subjects",
    "modelArtifact",
    "claims"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "orchestra.openshift.sno-trial-dependency-risk-evidence.v1"},
    "evidenceId": {
      "type": "string",
      "pattern": "^orchestra-sno-trial-dependency-risk-evidence-[a-z0-9][a-z0-9.-]+$"
    },
    "profileId": {"const": "orchestra-ocp-sno-trial-amd64-v1"},
    "targetClass": {"const": "engineering-trial"},
    "executionMode": {"const": "live"},
    "bindings": {"$ref": "#/$defs/evidenceBindings"},
    "collection": {"$ref": "#/$defs/collection"},
    "subjects": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/subject"}
    },
    "modelArtifact": {"$ref": "#/$defs/modelArtifact"},
    "claims": {"$ref": "#/$defs/claims"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nullableDigest": {
      "anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "evidenceBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifactSetDigest", "releaseSetDigest", "riskPolicyDigest"],
      "properties": {
        "artifactSetDigest": {"$ref": "#/$defs/digest"},
        "releaseSetDigest": {"$ref": "#/$defs/digest"},
        "riskPolicyDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionClass",
        "runnerRelease",
        "runnerRevision",
        "runnerImage",
        "runnerImageDigest",
        "runnerToolchainDigest",
        "actorIdentityDigest",
        "startedAt",
        "completedAt",
        "collectionStatementDigest",
        "collectionSignatureBundleDigest",
        "vulnerabilityScanner",
        "sbomScanner",
        "signatureProbe",
        "rawArtifactsRestricted"
      ],
      "properties": {
        "executionClass": {"const": "signed-certification-runner"},
        "runnerRelease": {"type": "string", "minLength": 1},
        "runnerRevision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "runnerImage": {
          "type": "string",
          "pattern": "^ghcr\\.io/caglarsubas/agent-hook-v2/orchestra-certification-runner-ubi@sha256:[a-f0-9]{64}$"
        },
        "runnerImageDigest": {"$ref": "#/$defs/digest"},
        "runnerToolchainDigest": {"$ref": "#/$defs/digest"},
        "actorIdentityDigest": {"$ref": "#/$defs/digest"},
        "startedAt": {"$ref": "#/$defs/timestamp"},
        "completedAt": {"$ref": "#/$defs/timestamp"},
        "collectionStatementDigest": {"$ref": "#/$defs/digest"},
        "collectionSignatureBundleDigest": {"$ref": "#/$defs/digest"},
        "vulnerabilityScanner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "databaseDigest", "javaDatabaseDigest"],
          "properties": {
            "name": {"const": "trivy"},
            "version": {"const": "0.72.0"},
            "databaseDigest": {"$ref": "#/$defs/digest"},
            "javaDatabaseDigest": {"$ref": "#/$defs/digest"}
          }
        },
        "sbomScanner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"const": "syft"},
            "version": {"const": "1.48.0"}
          }
        },
        "signatureProbe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "trustedRootDigest", "offlineVerification"],
          "properties": {
            "name": {"const": "cosign"},
            "version": {"const": "3.1.1"},
            "trustedRootDigest": {"$ref": "#/$defs/digest"},
            "offlineVerification": {"const": false}
          }
        },
        "rawArtifactsRestricted": {"const": true}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "digest"],
      "properties": {
        "fileName": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]+$"
        },
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "severityCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "UNKNOWN"],
      "properties": {
        "CRITICAL": {"type": "integer", "minimum": 0},
        "HIGH": {"type": "integer", "minimum": 0},
        "MEDIUM": {"type": "integer", "minimum": 0},
        "LOW": {"type": "integer", "minimum": 0},
        "UNKNOWN": {"type": "integer", "minimum": 0}
      }
    },
    "controlState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requiredBefore", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "requiredBefore": {"enum": ["review", "activation"]},
        "status": {"const": "declared-not-proven"}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "indexSubject",
        "platformSubject",
        "sourceRevision",
        "declaredLicense",
        "signatureObservation",
        "artifacts",
        "vulnerabilities",
        "licenses",
        "compensatingControls",
        "machineReview"
      ],
      "properties": {
        "id": {"enum": ["model-backend-image", "valkey-image"]},
        "indexSubject": {
          "type": "string",
          "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$"
        },
        "platformSubject": {
          "type": "string",
          "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$"
        },
        "sourceRevision": {
          "anyOf": [
            {"type": "string", "pattern": "^[a-f0-9]{40}$"},
            {"type": "null"}
          ]
        },
        "declaredLicense": {"type": "string", "minLength": 1},
        "signatureObservation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "indexSubject", "probeDigest"],
          "properties": {
            "status": {"const": "no-signature-found"},
            "indexSubject": {
              "type": "string",
              "pattern": "^[^\\s@]+@sha256:[a-f0-9]{64}$"
            },
            "probeDigest": {"$ref": "#/$defs/digest"}
          }
        },
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vulnerability", "sbom"],
          "properties": {
            "vulnerability": {"$ref": "#/$defs/artifact"},
            "sbom": {"$ref": "#/$defs/artifact"}
          }
        },
        "vulnerabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "bySeverity",
            "fixAvailableBySeverity",
            "scanTargetCount",
            "thresholdState"
          ],
          "properties": {
            "total": {"type": "integer", "minimum": 0},
            "bySeverity": {"$ref": "#/$defs/severityCounts"},
            "fixAvailableBySeverity": {"$ref": "#/$defs/severityCounts"},
            "scanTargetCount": {"type": "integer", "minimum": 1},
            "thresholdState": {"enum": ["passed", "blocked"]}
          }
        },
        "licenses": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packageCount",
            "expressions",
            "noAssertionCount",
            "noneCount",
            "inventoryDigest",
            "humanReviewState"
          ],
          "properties": {
            "packageCount": {"type": "integer", "minimum": 1},
            "expressions": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "noAssertionCount": {"type": "integer", "minimum": 0},
            "noneCount": {"type": "integer", "minimum": 0},
            "inventoryDigest": {"$ref": "#/$defs/digest"},
            "humanReviewState": {"const": "required"}
          }
        },
        "compensatingControls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["planDigest", "controls"],
          "properties": {
            "planDigest": {"$ref": "#/$defs/digest"},
            "controls": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {"$ref": "#/$defs/controlState"}
            }
          }
        },
        "machineReview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reasonCodes", "reviewDigest"],
          "properties": {
            "state": {"enum": ["blocked", "eligible-for-human-review"]},
            "reasonCodes": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "reviewDigest": {"$ref": "#/$defs/digest"}
          }
        }
      }
    },
    "licenseReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reviewerIdentityDigest", "reviewDigest"],
      "properties": {
        "state": {"enum": ["required", "complete"]},
        "reviewerIdentityDigest": {"$ref": "#/$defs/nullableDigest"},
        "reviewDigest": {"$ref": "#/$defs/nullableDigest"}
      }
    },
    "modelArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "immutableUrl",
        "revision",
        "expectedDigest",
        "observedDigest",
        "expectedSizeBytes",
        "observedSizeBytes",
        "declaredLicense",
        "bytesVerified",
        "contentLengthVerified",
        "verificationDigest",
        "licenseReview"
      ],
      "properties": {
        "id": {"const": "orchestra-reference-cpu-model"},
        "immutableUrl": {"type": "string", "pattern": "^https://"},
        "revision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "expectedDigest": {"$ref": "#/$defs/digest"},
        "observedDigest": {"$ref": "#/$defs/digest"},
        "expectedSizeBytes": {"type": "integer", "minimum": 1, "maximum": 4294967296},
        "observedSizeBytes": {"type": "integer", "minimum": 1, "maximum": 4294967296},
        "declaredLicense": {"const": "Apache-2.0"},
        "bytesVerified": {"const": true},
        "contentLengthVerified": {"const": true},
        "verificationDigest": {"$ref": "#/$defs/digest"},
        "licenseReview": {"$ref": "#/$defs/licenseReview"}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allSubjectsCollected",
        "vulnerabilityThresholdPassedCount",
        "eligibleForHumanReviewCount",
        "modelIntegrityVerified",
        "modelLicenseReviewComplete",
        "containerLicenseReviewsComplete",
        "exceptionsApproved",
        "sourceAdmissionAuthorized",
        "mirrorAuthorization",
        "activationAuthorized",
        "deploymentAuthorized",
        "campaignEvidence",
        "referenceProfileVerified"
      ],
      "properties": {
        "allSubjectsCollected": {"const": true},
        "vulnerabilityThresholdPassedCount": {"type": "integer", "minimum": 0, "maximum": 2},
        "eligibleForHumanReviewCount": {"type": "integer", "minimum": 0, "maximum": 2},
        "modelIntegrityVerified": {"const": true},
        "modelLicenseReviewComplete": {"type": "boolean"},
        "containerLicenseReviewsComplete": {"const": false},
        "exceptionsApproved": {"const": false},
        "sourceAdmissionAuthorized": {"const": false},
        "mirrorAuthorization": {"const": false},
        "activationAuthorized": {"const": false},
        "deploymentAuthorized": {"const": false},
        "campaignEvidence": {"const": false},
        "referenceProfileVerified": {"const": false}
      }
    }
  }
}
