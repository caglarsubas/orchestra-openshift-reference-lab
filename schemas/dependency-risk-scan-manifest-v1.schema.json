{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prometa.ai/orchestra/dependency-risk-scan-manifest-v1.schema.json",
  "title": "Orchestra unsigned dependency scan manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "targetClass",
    "executionMode",
    "evidenceId",
    "bindings",
    "collection",
    "subjects"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "profileId": {"const": "orchestra-ocp-4.20-amd64-v1"},
    "targetClass": {"const": "vendor-reference-lab"},
    "executionMode": {"const": "live"},
    "evidenceId": {
      "type": "string",
      "pattern": "^orchestra-dependency-risk-evidence-[a-z0-9][a-z0-9.-]+$"
    },
    "bindings": {"$ref": "#/$defs/bindings"},
    "collection": {"$ref": "#/$defs/collection"},
    "subjects": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/scanSubject"}
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topologyDigest",
        "dependencyAdmissionDigest",
        "sourceVerificationDigest",
        "riskPolicyDigest",
        "releaseSetDigest"
      ],
      "properties": {
        "topologyDigest": {"$ref": "#/$defs/digest"},
        "dependencyAdmissionDigest": {"$ref": "#/$defs/digest"},
        "sourceVerificationDigest": {"$ref": "#/$defs/digest"},
        "riskPolicyDigest": {"$ref": "#/$defs/digest"},
        "releaseSetDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionClass",
        "runnerRelease",
        "runnerRevision",
        "runnerImage",
        "runnerImageDigest",
        "runnerToolchainDigest",
        "runnerReleaseManifestFile",
        "runnerReleaseManifestDigest",
        "runnerReleaseManifestSignatureBundleFile",
        "runnerReleaseManifestSignatureBundleDigest",
        "runnerProvenanceBundleFile",
        "runnerProvenanceBundleDigest",
        "runnerReleaseMetadataFile",
        "runnerReleaseMetadataDigest",
        "runnerToolchainLockFile",
        "collectorScriptFile",
        "collectorScriptDigest",
        "actorIdentityDigest",
        "signingPublicKeyFile",
        "signingPublicKeyDigest",
        "startedAt",
        "completedAt",
        "collectionAttestationFile",
        "collectionAttestationDigest",
        "collectionSignatureBundleFile",
        "collectionSignatureBundleDigest",
        "vulnerabilityScanner",
        "sbomScanner",
        "invocationPolicy"
      ],
      "properties": {
        "executionClass": {"const": "signed-certification-runner"},
        "runnerRelease": {
          "type": "string",
          "pattern": "^platform-v[0-9]+\\.[0-9]+\\.[0-9]+-rc\\.[0-9]+$"
        },
        "runnerRevision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "runnerImage": {
          "type": "string",
          "pattern": "^ghcr\\.io/caglarsubas/agent-hook-v2/orchestra-certification-runner-ubi@sha256:[a-f0-9]{64}$"
        },
        "runnerImageDigest": {"$ref": "#/$defs/digest"},
        "runnerToolchainDigest": {"$ref": "#/$defs/digest"},
        "runnerReleaseManifestFile": {"const": "platform-release-manifest.json"},
        "runnerReleaseManifestDigest": {"$ref": "#/$defs/digest"},
        "runnerReleaseManifestSignatureBundleFile": {
          "const": "platform-release-manifest.sigstore.json"
        },
        "runnerReleaseManifestSignatureBundleDigest": {"$ref": "#/$defs/digest"},
        "runnerProvenanceBundleFile": {
          "const": "platform-release-manifest.provenance.sigstore.json"
        },
        "runnerProvenanceBundleDigest": {"$ref": "#/$defs/digest"},
        "runnerReleaseMetadataFile": {
          "const": "release-orchestra-certification-runner-ubi.json"
        },
        "runnerReleaseMetadataDigest": {"$ref": "#/$defs/digest"},
        "runnerToolchainLockFile": {
          "const": "certification-runner-toolchain-lock.json"
        },
        "collectorScriptFile": {"const": "dependency-risk-collector.sh"},
        "collectorScriptDigest": {"$ref": "#/$defs/digest"},
        "actorIdentityDigest": {"$ref": "#/$defs/digest"},
        "signingPublicKeyFile": {"const": "collection-signing-public-key.pem"},
        "signingPublicKeyDigest": {"$ref": "#/$defs/digest"},
        "startedAt": {"$ref": "#/$defs/timestamp"},
        "completedAt": {"$ref": "#/$defs/timestamp"},
        "collectionAttestationFile": {
          "const": "dependency-risk-collection-statement.json"
        },
        "collectionAttestationDigest": {"$ref": "#/$defs/digest"},
        "collectionSignatureBundleFile": {
          "const": "dependency-risk-collection-signature.sigstore.json"
        },
        "collectionSignatureBundleDigest": {"$ref": "#/$defs/digest"},
        "vulnerabilityScanner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "databaseDigest", "javaDatabaseDigest"],
          "properties": {
            "name": {"const": "trivy"},
            "version": {"const": "0.72.0"},
            "databaseDigest": {"$ref": "#/$defs/digest"},
            "javaDatabaseDigest": {"$ref": "#/$defs/digest"}
          }
        },
        "sbomScanner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"const": "syft"},
            "version": {"const": "1.48.0"}
          }
        },
        "invocationPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "imageSource",
            "vulnerabilityScanners",
            "ignoreFileUsed",
            "ignoreUnfixed",
            "severityFilter",
            "externalConfigUsed",
            "databaseUpdatesDuringScan",
            "offlineScan",
            "sbomSource",
            "sbomFormat"
          ],
          "properties": {
            "platform": {"const": "linux/amd64"},
            "imageSource": {"const": "remote"},
            "vulnerabilityScanners": {
              "type": "array",
              "prefixItems": [{"const": "vuln"}],
              "items": false,
              "minItems": 1,
              "maxItems": 1
            },
            "ignoreFileUsed": {"const": false},
            "ignoreUnfixed": {"const": false},
            "severityFilter": {"type": "array", "maxItems": 0},
            "externalConfigUsed": {"const": false},
            "databaseUpdatesDuringScan": {"const": false},
            "offlineScan": {"const": true},
            "sbomSource": {"const": "registry"},
            "sbomFormat": {"const": "spdx-2.3-json"}
          }
        }
      }
    },
    "scanSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceSubject",
        "platformSubject",
        "vulnerabilityReportFile",
        "vulnerabilityReportDigest",
        "sbomFile",
        "sbomDigest"
      ],
      "properties": {
        "id": {
          "enum": [
            "barman-cloud-controller",
            "barman-cloud-sidecar",
            "clickhouse-metrics-exporter",
            "clickhouse-operator",
            "clickhouse-server-lts",
            "nats-config-reloader",
            "nats-server",
            "vault-server"
          ]
        },
        "sourceSubject": {"type": "string", "minLength": 1},
        "platformSubject": {"type": "string", "minLength": 1},
        "vulnerabilityReportFile": {"$ref": "#/$defs/fileName"},
        "vulnerabilityReportDigest": {"$ref": "#/$defs/digest"},
        "sbomFile": {"$ref": "#/$defs/fileName"},
        "sbomDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "fileName": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^/\\\\]+$"
    }
  }
}
