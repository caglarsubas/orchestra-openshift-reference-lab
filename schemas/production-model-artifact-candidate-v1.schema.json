    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "candidateDigest": {
      "$ref": "#/$defs/digest"
    },
    "candidateId": {
      "const": "orchestra-production-model-artifacts-2026-07-28.1"
    },
    "claims": {
      "$ref": "#/$defs/claims"
    },
    "container": {
      "$ref": "#/$defs/container"
    },
    "controls": {
      "$ref": "#/$defs/controls"
    },
    "executionMode": {
      "const": "source-only"
    },
    "kind": {
      "const": "orchestra.openshift.production-model-artifact-candidate.v1"
    },
    "models": {
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/chatModel"
        },
        {
          "$ref": "#/$defs/embeddingModel"
        }
      ],
      "type": "array"
    },
    "profileId": {
      "const": "orchestra-ocp-4.20-amd64-v1"
    },
    "runtimeBindings": {
      "items": false,
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "$ref": "#/$defs/chatRuntime"
        },
        {
          "$ref": "#/$defs/embeddingRuntime"
        }
      ],
      "type": "array"
    },
    "schemaVersion": {
      "const": 1
    },
    "targetClass": {
      "const": "vendor-reference-lab"
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "candidateId",
    "profileId",
    "targetClass",
    "executionMode",
    "architecture",
    "bindings",
    "container",
    "models",
    "runtimeBindings",
    "activation",
    "controls",
    "claims",
    "candidateDigest"
  ],
  "title": "Orchestra production model artifact candidate v1",
  "type": "object"
}
