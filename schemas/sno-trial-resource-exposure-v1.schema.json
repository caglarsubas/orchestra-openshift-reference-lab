{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://planeon.ai/schemas/sno-trial-resource-exposure-v1.schema.json",
  "title": "Orchestra SNO trial resource exposure",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "assessmentId",
    "generatedAt",
    "targetClass",
    "executionMode",
    "bindings",
    "resourceState",
    "costEstimate",
    "decision",
    "controls",
    "claims",
    "reportDigest"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "orchestra.openshift.sno-trial-resource-exposure.v1"
    },
    "assessmentId": {
      "type": "string",
      "pattern": "^sno-exposure-[a-z0-9][a-z0-9.-]{5,79}$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "targetClass": {
      "const": "engineering-trial"
    },
    "executionMode": {
      "enum": [
        "simulated",
        "live-diagnostic"
      ]
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "resourceState": {
      "$ref": "#/$defs/resourceState"
    },
    "costEstimate": {
      "$ref": "#/$defs/costEstimate"
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "controls": {
      "$ref": "#/$defs/controls"
    },
    "claims": {
      "$ref": "#/$defs/claims"
    },
    "reportDigest": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)(?:\\.[0-9]{1,9})?$"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "profileDigest",
        "billingExecutionDigest",
        "costRateCardDigest",
        "targetProjectId",
        "targetProjectIdentityDigest",
        "operatorProjectIdentityDigest",
        "operatorInstanceIdentityDigest"
      ],
      "properties": {
        "profileId": {
          "const": "orchestra-ocp-sno-trial-amd64-v1"
        },
        "profileDigest": {
          "$ref": "#/$defs/digest"
        },
        "billingExecutionDigest": {
          "$ref": "#/$defs/digest"
        },
        "costRateCardDigest": {
          "$ref": "#/$defs/digest"
        },
        "targetProjectId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
        },
        "targetProjectIdentityDigest": {
          "$ref": "#/$defs/digest"
        },
        "operatorProjectIdentityDigest": {
          "$ref": "#/$defs/digest"
        },
        "operatorInstanceIdentityDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "managedNameCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "addresses",
        "buckets",
        "customRoles",
        "firewalls",
        "forwardingRules",
        "networks",
        "routers",
        "serviceAccounts",
        "subnetworks",
        "workloadIdentityPools"
      ],
      "properties": {
        "addresses": {
          "type": "integer",
          "minimum": 0
        },
        "buckets": {
          "type": "integer",
          "minimum": 0
        },
        "customRoles": {
          "type": "integer",
          "minimum": 0
        },
        "firewalls": {
          "type": "integer",
          "minimum": 0
        },
        "forwardingRules": {
          "type": "integer",
          "minimum": 0
        },
        "networks": {
          "type": "integer",
          "minimum": 0
        },
        "routers": {
          "type": "integer",
          "minimum": 0
        },
        "serviceAccounts": {
          "type": "integer",
          "minimum": 0
        },
        "subnetworks": {
          "type": "integer",
          "minimum": 0
        },
        "workloadIdentityPools": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "targetState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceCount",
        "managedInstanceCount",
        "diskCount",
        "managedDiskCount",
        "managedNameCounts",
        "managedResourceCount",
        "inventoryDigest"
      ],
      "properties": {
        "instanceCount": {
          "type": "integer",
          "minimum": 0
        },
        "managedInstanceCount": {
          "type": "integer",
          "minimum": 0
        },
        "diskCount": {
          "type": "integer",
          "minimum": 0
        },
        "managedDiskCount": {
          "type": "integer",
          "minimum": 0
        },
        "managedNameCounts": {
          "$ref": "#/$defs/managedNameCounts"
        },
        "managedResourceCount": {
          "type": "integer",
          "minimum": 0
        },
        "inventoryDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "operatorState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instanceCount",
        "diskCount",
        "resourceCount",
        "inventoryDigest"
      ],
      "properties": {
        "instanceCount": {
          "type": "integer",
          "minimum": 0
        },
        "diskCount": {
          "type": "integer",
          "minimum": 0
        },
        "resourceCount": {
          "type": "integer",
          "minimum": 0
        },
        "inventoryDigest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "resourceState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase",
        "observedAt",
        "target",
        "operator"
      ],
      "properties": {
        "phase": {
          "enum": [
            "active",
            "post-teardown"
          ]
        },
        "observedAt": {
          "type": "string",
          "format": "date-time"
        },
        "target": {
          "$ref": "#/$defs/targetState"
        },
        "operator": {
          "$ref": "#/$defs/operatorState"
        }
      }
    },
    "costEstimate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "targetComputeUsd",
        "targetDiskUsd",
        "operatorComputeUsd",
        "operatorDiskUsd",
        "targetInstanceHours",
        "targetDiskGiBHours",
        "operatorInstanceHours",
        "operatorDiskGiBHours",
        "estimatedUsdSubtotal",
        "estimatedTrySubtotal",
        "monthlyUsdAlertCeiling",
        "estimateComplete",
        "unpricedResourceClasses",
        "excludedChargeClasses",
        "billingExportVerified",
        "estimateIsBilledSpend"
      ],
      "properties": {
        "targetComputeUsd": {
          "$ref": "#/$defs/decimal"
        },
        "targetDiskUsd": {
          "$ref": "#/$defs/decimal"
        },
        "operatorComputeUsd": {
          "$ref": "#/$defs/decimal"
        },
        "operatorDiskUsd": {
          "$ref": "#/$defs/decimal"
        },
        "targetInstanceHours": {
          "$ref": "#/$defs/decimal"
        },
        "targetDiskGiBHours": {
          "$ref": "#/$defs/decimal"
        },
        "operatorInstanceHours": {
          "$ref": "#/$defs/decimal"
        },
        "operatorDiskGiBHours": {
          "$ref": "#/$defs/decimal"
        },
        "estimatedUsdSubtotal": {
          "$ref": "#/$defs/decimal"
        },
        "estimatedTrySubtotal": {
          "$ref": "#/$defs/decimal"
        },
        "monthlyUsdAlertCeiling": {
          "$ref": "#/$defs/decimal"
        },
        "estimateComplete": {
          "const": false
        },
        "unpricedResourceClasses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "excludedChargeClasses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "billingExportVerified": {
          "const": false
        },
        "estimateIsBilledSpend": {
          "const": false
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasonCodes",
        "nextAction"
      ],
      "properties": {
        "status": {
          "enum": [
            "ACTIVE_EXPOSURE_OBSERVED",
            "TEARDOWN_RESIDUALS_CLEAN",
            "BLOCKED"
          ]
        },
        "reasonCodes": {
          "type": "array",
          "items": {
            "enum": [
              "TARGET_INSTANCE_COUNT_MISMATCH",
              "TARGET_DISK_COUNT_MISMATCH",
              "OPERATOR_INSTANCE_COUNT_MISMATCH",
              "OPERATOR_DISK_COUNT_MISMATCH",
              "UNPRICED_RESOURCE_PRESENT",
              "ESTIMATE_AT_OR_ABOVE_ALERT_CEILING",
              "TARGET_RESIDUALS_PRESENT",
              "OPERATOR_RESIDUALS_PRESENT"
            ]
          },
          "uniqueItems": true
        },
        "nextAction": {
          "enum": [
            "run-bounded-tests-then-teardown-before-lease-expiry",
            "review-resource-and-cost-drift",
            "close-lease-and-preserve-payload-free-receipt",
            "reconcile-residual-resources"
          ]
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandPolicy",
        "rawProviderOutputStored",
        "resourceNamesStored",
        "credentialValuesStored",
        "costEstimateOnly",
        "billedCostVerified",
        "cleanupAuthorized",
        "teardownAuthorized",
        "campaignEligible",
        "allowedCertificationSlots"
      ],
      "properties": {
        "commandPolicy": {
          "const": "read-only"
        },
        "rawProviderOutputStored": {
          "const": false
        },
        "resourceNamesStored": {
          "const": false
        },
        "credentialValuesStored": {
          "const": false
        },
        "costEstimateOnly": {
          "const": true
        },
        "billedCostVerified": {
          "const": false
        },
        "cleanupAuthorized": {
          "const": false
        },
        "teardownAuthorized": {
          "const": false
        },
        "campaignEligible": {
          "const": false
        },
        "allowedCertificationSlots": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaignEvidence",
        "referenceProfileVerified",
        "customerCertified",
        "redHatCertified",
        "contractualSla",
        "productionSupported",
        "highAvailability",
        "rpoRtoVerified"
      ],
      "properties": {
        "campaignEvidence": {
          "const": false
        },
        "referenceProfileVerified": {
          "const": false
        },
        "customerCertified": {
          "const": false
        },
        "redHatCertified": {
          "const": false
        },
        "contractualSla": {
          "const": false
        },
        "productionSupported": {
          "const": false
        },
        "highAvailability": {
          "const": false
        },
        "rpoRtoVerified": {
          "const": false
        }
      }
    }
  }
}
