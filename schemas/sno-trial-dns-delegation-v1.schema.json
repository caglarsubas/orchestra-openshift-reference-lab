{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prometa.ai/orchestra/reference-lab/sno-trial-dns-delegation-v1.schema.json",
  "title": "Orchestra OpenShift SNO trial DNS delegation v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "kind",
    "assessmentId",
    "generatedAt",
    "targetClass",
    "executionMode",
    "bindings",
    "providerState",
    "decision",
    "controls",
    "claims",
    "reportDigest"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "kind": {"const": "orchestra.openshift.sno-trial-dns-delegation.v1"},
    "assessmentId": {
      "type": "string",
      "pattern": "^sno-dns-[a-z0-9][a-z0-9.-]{5,79}$"
    },
    "generatedAt": {"type": "string", "format": "date-time"},
    "targetClass": {"const": "engineering-trial"},
    "executionMode": {
      "enum": ["simulated", "live-diagnostic"]
    },
    "bindings": {"$ref": "#/$defs/bindings"},
    "providerState": {"$ref": "#/$defs/providerState"},
    "decision": {"$ref": "#/$defs/decision"},
    "controls": {"$ref": "#/$defs/controls"},
    "claims": {"$ref": "#/$defs/claims"},
    "reportDigest": {"$ref": "#/$defs/digest"}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profileId",
        "profileDigest",
        "projectId",
        "projectIdentityDigest",
        "managedZoneName",
        "dnsName"
      ],
      "properties": {
        "profileId": {"const": "orchestra-ocp-sno-trial-amd64-v1"},
        "profileDigest": {"$ref": "#/$defs/digest"},
        "projectId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
        },
        "projectIdentityDigest": {"$ref": "#/$defs/digest"},
        "managedZoneName": {
          "const": "orchestra-ocp-sno-trial-planeon-public"
        },
        "dnsName": {"const": "ocp-lab.planeon.ai."}
      }
    },
    "providerState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAt",
        "projectId",
        "projectIdentityDigest",
        "managedZoneIdentityDigest",
        "dnsName",
        "visibility",
        "providerZoneMatches",
        "providerNameServersValid",
        "providerNameServerCount",
        "providerNameServerSetDigest",
        "delegatedNameServerCount",
        "delegatedNameServerSetDigest",
        "delegationExact"
      ],
      "properties": {
        "observedAt": {"type": "string", "format": "date-time"},
        "projectId": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{4,28}[a-z0-9]$"
        },
        "projectIdentityDigest": {"$ref": "#/$defs/digest"},
        "managedZoneIdentityDigest": {"$ref": "#/$defs/digest"},
        "dnsName": {
          "type": "string",
          "pattern": "^(?:[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?\\.){2,}$"
        },
        "visibility": {"enum": ["public", "private"]},
        "providerZoneMatches": {"type": "boolean"},
        "providerNameServersValid": {"type": "boolean"},
        "providerNameServerCount": {"type": "integer", "minimum": 0},
        "providerNameServerSetDigest": {"$ref": "#/$defs/digest"},
        "delegatedNameServerCount": {"type": "integer", "minimum": 0},
        "delegatedNameServerSetDigest": {"$ref": "#/$defs/digest"},
        "delegationExact": {"type": "boolean"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasonCodes", "nextAction"],
      "properties": {
        "status": {
          "enum": [
            "DELEGATION_OBSERVED",
            "WAITING_DELEGATION",
            "BLOCKED"
          ]
        },
        "reasonCodes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "MANAGED_ZONE_POLICY_MISMATCH",
              "MANAGED_ZONE_NAMESERVERS_INVALID",
              "PUBLIC_DELEGATION_MISSING",
              "PUBLIC_DELEGATION_MISMATCH"
            ]
          }
        },
        "nextAction": {
          "enum": [
            "reconcile-managed-zone-identity",
            "reconcile-managed-zone-nameservers",
            "publish-parent-ns-delegation",
            "correct-parent-ns-delegation",
            "verify-source-cidr-admin-path-and-operator-lease"
          ]
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "commandPolicy",
        "rawProviderOutputStored",
        "secretValuesStored",
        "cloudMutationAuthorized",
        "dnsMutationAuthorized",
        "installAuthorized",
        "campaignEligible",
        "allowedCertificationSlots"
      ],
      "properties": {
        "commandPolicy": {"const": "read-only"},
        "rawProviderOutputStored": {"const": false},
        "secretValuesStored": {"const": false},
        "cloudMutationAuthorized": {"const": false},
        "dnsMutationAuthorized": {"const": false},
        "installAuthorized": {"const": false},
        "campaignEligible": {"const": false},
        "allowedCertificationSlots": {
          "type": "array",
          "maxItems": 0
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaignEvidence",
        "referenceProfileVerified",
        "customerCertified",
        "redHatCertified",
        "contractualSla",
        "productionSupported",
        "highAvailability",
        "rpoRtoVerified"
      ],
      "properties": {
        "campaignEvidence": {"const": false},
        "referenceProfileVerified": {"const": false},
        "customerCertified": {"const": false},
        "redHatCertified": {"const": false},
        "contractualSla": {"const": false},
        "productionSupported": {"const": false},
        "highAvailability": {"const": false},
        "rpoRtoVerified": {"const": false}
      }
    }
  }
}
