{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.prometa.ai/orchestra/dependency-risk-evidence-v1.schema.json",
  "title": "Orchestra unsigned dependency risk evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profileId",
    "targetClass",
    "executionMode",
    "evidenceId",
    "bindings",
    "collection",
    "subjects",
    "claim"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "profileId": {"const": "orchestra-ocp-4.20-amd64-v1"},
    "targetClass": {"const": "vendor-reference-lab"},
    "executionMode": {"const": "live"},
    "evidenceId": {
      "type": "string",
      "pattern": "^orchestra-dependency-risk-evidence-[a-z0-9][a-z0-9.-]+$"
    },
    "bindings": {"$ref": "#/$defs/bindings"},
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executionClass",
        "runnerRelease",
        "runnerRevision",
        "runnerImage",
        "runnerImageDigest",
        "runnerToolchainDigest",
        "runnerReleaseManifestFile",
        "runnerReleaseManifestDigest",
        "runnerReleaseManifestSignatureBundleFile",
        "runnerReleaseManifestSignatureBundleDigest",
        "runnerProvenanceBundleFile",
        "runnerProvenanceBundleDigest",
        "runnerReleaseMetadataFile",
        "runnerReleaseMetadataDigest",
        "runnerToolchainLockFile",
        "collectorScriptFile",
        "collectorScriptDigest",
        "actorIdentityDigest",
        "signingPublicKeyFile",
        "signingPublicKeyDigest",
        "startedAt",
        "completedAt",
        "collectionAttestationFile",
        "collectionAttestationDigest",
        "collectionSignatureBundleFile",
        "collectionSignatureBundleDigest",
        "vulnerabilityScanner",
        "sbomScanner",
        "invocationPolicy"
      ],
      "properties": {
        "executionClass": {"const": "signed-certification-runner"},
        "runnerRelease": {
          "type": "string",
          "pattern": "^platform-v[0-9]+\\.[0-9]+\\.[0-9]+-rc\\.[0-9]+$"
        },
        "runnerRevision": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "runnerImage": {
          "type": "string",
          "pattern": "^ghcr\\.io/caglarsubas/agent-hook-v2/orchestra-certification-runner-ubi@sha256:[a-f0-9]{64}$"
        },
        "runnerImageDigest": {"$ref": "#/$defs/digest"},
        "runnerToolchainDigest": {"$ref": "#/$defs/digest"},
        "runnerReleaseManifestFile": {"const": "platform-release-manifest.json"},
        "runnerReleaseManifestDigest": {"$ref": "#/$defs/digest"},
        "runnerReleaseManifestSignatureBundleFile": {
          "const": "platform-release-manifest.sigstore.json"
        },
        "runnerReleaseManifestSignatureBundleDigest": {"$ref": "#/$defs/digest"},
        "runnerProvenanceBundleFile": {
          "const": "platform-release-manifest.provenance.sigstore.json"
        },
        "runnerProvenanceBundleDigest": {"$ref": "#/$defs/digest"},
        "runnerReleaseMetadataFile": {
          "const": "release-orchestra-certification-runner-ubi.json"
        },
        "runnerReleaseMetadataDigest": {"$ref": "#/$defs/digest"},
        "runnerToolchainLockFile": {
          "const": "certification-runner-toolchain-lock.json"
        },
        "collectorScriptFile": {"const": "dependency-risk-collector.sh"},
        "collectorScriptDigest": {"$ref": "#/$defs/digest"},
        "actorIdentityDigest": {"$ref": "#/$defs/digest"},
        "signingPublicKeyFile": {"const": "collection-signing-public-key.pem"},
        "signingPublicKeyDigest": {"$ref": "#/$defs/digest"},
        "startedAt": {"$ref": "#/$defs/timestamp"},
        "completedAt": {"$ref": "#/$defs/timestamp"},
        "collectionAttestationFile": {
          "const": "dependency-risk-collection-statement.json"
        },
        "collectionAttestationDigest": {"$ref": "#/$defs/digest"},
        "collectionSignatureBundleFile": {
          "const": "dependency-risk-collection-signature.sigstore.json"
        },
        "collectionSignatureBundleDigest": {"$ref": "#/$defs/digest"},
        "vulnerabilityScanner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version", "databaseDigest", "javaDatabaseDigest"],
          "properties": {
            "name": {"const": "trivy"},
            "version": {"const": "0.72.0"},
            "databaseDigest": {"$ref": "#/$defs/digest"},
            "javaDatabaseDigest": {"$ref": "#/$defs/digest"}
          }
        },
        "sbomScanner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {"const": "syft"},
            "version": {"const": "1.48.0"}
          }
        },
        "invocationPolicy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "platform",
            "imageSource",
            "vulnerabilityScanners",
            "ignoreFileUsed",
            "ignoreUnfixed",
            "severityFilter",
            "externalConfigUsed",
            "databaseUpdatesDuringScan",
            "offlineScan",
            "sbomSource",
            "sbomFormat"
          ],
          "properties": {
            "platform": {"const": "linux/amd64"},
            "imageSource": {"const": "remote"},
            "vulnerabilityScanners": {
              "type": "array",
              "prefixItems": [{"const": "vuln"}],
              "items": false,
              "minItems": 1,
              "maxItems": 1
            },
            "ignoreFileUsed": {"const": false},
            "ignoreUnfixed": {"const": false},
            "severityFilter": {"type": "array", "maxItems": 0},
            "externalConfigUsed": {"const": false},
            "databaseUpdatesDuringScan": {"const": false},
            "offlineScan": {"const": true},
            "sbomSource": {"const": "registry"},
            "sbomFormat": {"const": "spdx-2.3-json"}
          }
        }
      }
    },
    "subjects": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/riskSubject"}
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allSubjectsCollected",
        "vulnerabilityThresholdPassedCount",
        "eligibleForHumanReviewCount",
        "licenseReviewsComplete",
        "exceptionsApproved",
        "sourceAdmissionAuthorized",
        "mirrorAuthorization",
        "activationAuthorized",
        "campaignEvidence"
      ],
      "properties": {
        "allSubjectsCollected": {"const": true},
        "vulnerabilityThresholdPassedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "eligibleForHumanReviewCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "licenseReviewsComplete": {"const": false},
        "exceptionsApproved": {"const": false},
        "sourceAdmissionAuthorized": {"const": false},
        "mirrorAuthorization": {"const": false},
        "activationAuthorized": {"const": false},
        "campaignEvidence": {"const": false}
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "topologyDigest",
        "dependencyAdmissionDigest",
        "sourceVerificationDigest",
        "riskPolicyDigest",
        "releaseSetDigest"
      ],
      "properties": {
        "topologyDigest": {"$ref": "#/$defs/digest"},
        "dependencyAdmissionDigest": {"$ref": "#/$defs/digest"},
        "sourceVerificationDigest": {"$ref": "#/$defs/digest"},
        "riskPolicyDigest": {"$ref": "#/$defs/digest"},
        "releaseSetDigest": {"$ref": "#/$defs/digest"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "digest"],
      "properties": {
        "fileName": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^/\\\\]+$"
        },
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "severityCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "UNKNOWN"],
      "properties": {
        "CRITICAL": {"type": "integer", "minimum": 0},
        "HIGH": {"type": "integer", "minimum": 0},
        "MEDIUM": {"type": "integer", "minimum": 0},
        "LOW": {"type": "integer", "minimum": 0},
        "UNKNOWN": {"type": "integer", "minimum": 0}
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requiredBefore", "status"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "requiredBefore": {"enum": ["review", "activation"]},
        "status": {"const": "declared-not-proven"}
      }
    },
    "riskSubject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sourceSubject",
        "platformSubject",
        "artifacts",
        "vulnerabilities",
        "licenses",
        "compensatingControls",
        "machineReview"
      ],
      "properties": {
        "id": {
          "enum": [
            "barman-cloud-controller",
            "barman-cloud-sidecar",
            "clickhouse-metrics-exporter",
            "clickhouse-operator",
            "clickhouse-server-lts",
            "nats-config-reloader",
            "nats-server",
            "vault-server"
          ]
        },
        "sourceSubject": {"type": "string", "minLength": 1},
        "platformSubject": {"type": "string", "minLength": 1},
        "artifacts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vulnerability", "sbom"],
          "properties": {
            "vulnerability": {"$ref": "#/$defs/artifact"},
            "sbom": {"$ref": "#/$defs/artifact"}
          }
        },
        "vulnerabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "bySeverity",
            "fixAvailableBySeverity",
            "scanTargetCount",
            "thresholdState"
          ],
          "properties": {
            "total": {"type": "integer", "minimum": 0},
            "bySeverity": {"$ref": "#/$defs/severityCounts"},
            "fixAvailableBySeverity": {"$ref": "#/$defs/severityCounts"},
            "scanTargetCount": {"type": "integer", "minimum": 1},
            "thresholdState": {"enum": ["passed", "blocked"]}
          }
        },
        "licenses": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "packageCount",
            "expressions",
            "noAssertionCount",
            "noneCount",
            "inventoryDigest",
            "humanReviewState"
          ],
          "properties": {
            "packageCount": {"type": "integer", "minimum": 1},
            "expressions": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "noAssertionCount": {"type": "integer", "minimum": 0},
            "noneCount": {"type": "integer", "minimum": 0},
            "inventoryDigest": {"$ref": "#/$defs/digest"},
            "humanReviewState": {"const": "required"}
          }
        },
        "compensatingControls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["planDigest", "controls"],
          "properties": {
            "planDigest": {"$ref": "#/$defs/digest"},
            "controls": {
              "type": "array",
              "minItems": 7,
              "maxItems": 7,
              "items": {"$ref": "#/$defs/control"}
            }
          }
        },
        "machineReview": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reasonCodes", "reviewDigest"],
          "properties": {
            "state": {"enum": ["blocked", "eligible-for-human-review"]},
            "reasonCodes": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "reviewDigest": {"$ref": "#/$defs/digest"}
          }
        }
      }
    }
  }
}
