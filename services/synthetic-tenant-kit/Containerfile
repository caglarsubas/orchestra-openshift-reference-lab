FROM registry.access.redhat.com/ubi9/python-312@sha256:5249b450c7b674c38d8611af2a74b48e288277bf36c77ec02bdfd3373fb9932b

USER 0
WORKDIR /opt/app-root/src

COPY pyproject.toml ./
COPY requirements-linux-amd64.lock ./
COPY src ./src
RUN python -m pip install \
        --no-cache-dir \
        --disable-pip-version-check \
        --only-binary=:all: \
        --require-hashes \
        --requirement requirements-linux-amd64.lock \
    && python -m pip install \
        --no-cache-dir \
        --disable-pip-version-check \
        --no-build-isolation \
        --no-deps \
        . \
    && python -m pip check \
    && rm -rf /root/.cache

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

USER 1001
EXPOSE 8443

ENTRYPOINT ["orchestra-synthetic-service"]
