{
  "global": {
    "repository": "europe-west1-docker.pkg.dev/ORCHESTRA_SERVICES_PROJECT_REQUIRED/orchestra-bootstrap/external-secrets",
    "imagePullSecrets": [
      {
        "name": "orchestra-bootstrap-registry"
      }
