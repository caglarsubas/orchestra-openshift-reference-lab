          "runtimeEdge": {
            "overloadContract": "orchestra-runtime-edge-overload-v1"
          },
          "fullnameOverride": "orchestra-runtime",
          "image": {
            "repository": "harbor.services.ocp-lab.prometa.ai/orchestra/runtime/prometa-runtime-host-ubi9",
            "tag": "",
            "digest": "sha256:09675478f3c45a636106df6a8e943ae0132d39c3fa814798a7470a8d84f11144",
            "pullPolicy": "IfNotPresent",
            "pullSecrets": [{ "name": "orchestra-registry" }]
          },
          "replicaCount": 2,
          "runtimeConfig": {
            "existingSecret": "orchestra-runtime-config",
            "existingConfigMap": "",
            "key": "config.json",
            "targetFile": "config.json",
            "rolloutId": "release-set-ec705bcc"
          },
          "credentials": {
            "existingSecret": "orchestra-runtime-credentials",
            "databaseUrlKey": "database-url",
            "apiTokenKey": "api-token",
            "modelGatewayApiKeyKey": "model-gateway-api-key",
            "modelGatewayApiKeyOptional": false,
            "controlPlaneApiKeyKey": "control-plane-api-key",
            "controlPlaneApiKeyOptional": true,
            "receiptApiKeyKey": "receipt-api-key",
            "receiptApiKeyOptional": false
          },
          "serviceAccount": {
            "create": true,
            "name": "orchestra-runtime",
            "annotations": {},
            "automountServiceAccountToken": false
          },
          "podSecurityContext": {
            "runAsNonRoot": true,
            "seccompProfile": { "type": "RuntimeDefault" }
          },
          "containerSecurityContext": {
            "allowPrivilegeEscalation": false,
            "readOnlyRootFilesystem": true,
            "capabilities": { "drop": ["ALL"] }
          },
          "service": { "type": "ClusterIP", "port": 8080 },
          "serverTls": {
            "enabled": true,
            "existingSecret": "orchestra-runtime-server-tls",
            "certificateKey": "tls.crt",
            "privateKeyKey": "tls.key",
            "clientCaKey": "ca.crt",
            "requireClientCertificate": false,
            "rolloutId": "release-set-ec705bcc"
          },
          "autoscaling": {
            "enabled": true,
            "minReplicas": 2,
            "maxReplicas": 6,
            "targetCPUUtilizationPercentage": 70
