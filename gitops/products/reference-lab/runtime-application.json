            {
              "maxSkew": 1,
              "topologyKey": "kubernetes.io/hostname",
              "whenUnsatisfiable": "DoNotSchedule",
              "labelSelector": {
                "matchLabels": {
                  "app.kubernetes.io/component": "runtime"
                }
              }
            }
          ],
          "migration": {
            "enabled": true,
            "compatibilityCheck": true,
            "serviceAccountName": "orchestra-runtime-migration",
            "existingSecret": "orchestra-runtime-migration",
            "databaseUrlKey": "migration-database-url",
            "networkPolicy": {
              "enabled": true,
              "allowDNS": true,
              "dnsNamespaceSelector": {
                "matchLabels": {
                  "kubernetes.io/metadata.name": "openshift-dns"
                }
              },
              "egress": [
                {
                  "to": [
                    { "ipBlock": { "cidr": "10.60.0.0/20" } },
                    { "ipBlock": { "cidr": "10.64.0.0/14" } },
                    { "ipBlock": { "cidr": "10.68.0.0/20" } }
                  ],
                  "ports": [{ "protocol": "TCP", "port": 5432 }]
                }
              ]
            }
          },
          "backup": { "enabled": false },
          "networkPolicy": {
            "enabled": true,
            "allowDNS": true,
            "dnsNamespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "openshift-dns"
              }
            },
            "ingress": [
              {
                "from": [
                  {
                    "namespaceSelector": {
                      "matchLabels": {
                        "kubernetes.io/metadata.name": "orchestra-synthetic"
                      }
                    },
                    "podSelector": {
                      "matchLabels": {
                        "app.kubernetes.io/name": "orchestra-tenant-gateway"
                      }
                    }
                  }
                ],
                "ports": [{ "protocol": "TCP", "port": 8080 }]
              }
            ],
            "egress": [
              {
                "to": [
                  {
                    "namespaceSelector": {
                      "matchLabels": {
                        "kubernetes.io/metadata.name": "orchestra-model"
                      }
                    }
                  }
                ],
                "ports": [{ "protocol": "TCP", "port": 8080 }]
              },
              {
                "to": [
                  { "ipBlock": { "cidr": "10.60.0.0/20" } },
                  { "ipBlock": { "cidr": "10.64.0.0/14" } },
                  { "ipBlock": { "cidr": "10.68.0.0/20" } }
                ],
                "ports": [
                  { "protocol": "TCP", "port": 443 },
                  { "protocol": "TCP", "port": 5432 },
                  { "protocol": "TCP", "port": 4317 },
                  { "protocol": "TCP", "port": 8443 }
                ]
              }
            ]
          },
          "extraEnv": [
            {
              "name": "SSL_CERT_FILE",
              "value": "/etc/orchestra-ca/ca-bundle.crt"
            }
          ],
          "extraVolumes": [
            {
              "name": "trusted-ca",
              "configMap": {
                "name": "orchestra-runtime-trusted-ca",
                "items": [
                  {
                    "key": "ca-bundle.crt",
                    "path": "ca-bundle.crt"
                  }
                ]
              }
            }
          ],
          "extraVolumeMounts": [
            {
              "name": "trusted-ca",
              "mountPath": "/etc/orchestra-ca",
              "readOnly": true
            }
          ]
        }
      }
    },
    "destination": {
      "server": "https://kubernetes.default.svc",
      "namespace": "orchestra-runtime"
    },
    "syncPolicy": {
      "automated": { "prune": true, "selfHeal": true },
      "syncOptions": [
        "CreateNamespace=false",
        "ServerSideApply=true"
      ],
      "retry": {
        "limit": 3,
        "backoff": {
          "duration": "10s",
          "factor": 2,
          "maxDuration": "3m"
        }
      }
    }
  }
