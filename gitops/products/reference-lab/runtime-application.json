  "spec": {
    "project": "orchestra-reference-lab",
    "source": {
      "repoURL": "harbor.services.ocp-lab.prometa.ai/orchestra/charts",
      "chart": "prometa-runtime",
      "targetRevision": "0.3.4",
      "helm": {
        "releaseName": "orchestra-runtime",
        "valuesObject": {
          "productionProfile": {
