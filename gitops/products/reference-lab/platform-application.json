{
  "apiVersion": "argoproj.io/v1alpha1",
  "kind": "Application",
  "metadata": {
    "name": "orchestra-platform",
    "namespace": "openshift-gitops",
    "annotations": {
      "orchestra.prometa.ai/release-set-digest": "sha256:d4b4ef7e33a6918d8a31d1f62cf704ae4bd8d4973e406f5a8a6d7ef0c1786428",
      "orchestra.prometa.ai/dependency-bom-digest": "sha256:fabec47064381d067ca759ba99c47470cc66628ecaacd2e0521f50bb29aad5dc",
      "orchestra.prometa.ai/dependency-admission-digest": "sha256:fc1f22817a5959e18d3f4493f199bda61b30cea441929ee321b531402e846def",
      "orchestra.prometa.ai/dependency-source-verification-digest": "sha256:cbfaa95d09e7a9ca1812028ba13f21c40846c3c91b32424d1e834eab6ab69f89",
      "orchestra.prometa.ai/source-revision": "188283376af4e3337f106fb58c5077ff9a6e774d",
      "orchestra.prometa.ai/source-chart-digest": "sha256:c07c5084b74048b94dee758d60bcb5054a382c347ee506077355080a4b8756f2"
    }
  },
  "spec": {
    "project": "orchestra-reference-lab",
    "source": {
      "repoURL": "harbor.services.ocp-lab.prometa.ai/orchestra/charts",
      "chart": "prometa",
      "targetRevision": "0.3.0-rc.8",
      "helm": {
        "releaseName": "orchestra-platform",
        "valuesObject": {
          "productionProfile": {
            "enabled": true,
            "profileId": "orchestra-ocp-4.20-amd64-v1",
            "imageFlavor": "ubi",
            "namespaceNetworkPoliciesReady": true
          },
          "fullnameOverride": "orchestra-platform",
          "image": {
            "repository": "harbor.services.ocp-lab.prometa.ai/orchestra/platform/prometa-ubi",
            "tag": "",
            "digest": "sha256:8e714a264d3292f4296398dabe900425b63ee745357c5029c4c808c839268b18",
            "pullPolicy": "IfNotPresent",
            "pullSecrets": [{ "name": "orchestra-registry" }]
          },
          "toolsImage": {
            "repository": "harbor.services.ocp-lab.prometa.ai/orchestra/platform/prometa-tools-ubi",
            "tag": "",
            "digest": "sha256:7da2df9a9c71b95a2d56ab44c4f94fff2a66acd1e4102a8cafeaca2017ed586d",
            "pullPolicy": "IfNotPresent"
          },
          "replicaCount": 2,
          "mode": "self-hosted",
          "env": "prod",
          "publicUrl": "https://platform.apps.ocp-lab.prometa.ai",
          "config": {
            "clickhouseUrl": "https://clickhouse.services.ocp-lab.prometa.ai:8443",
            "clickhouseDatabase": "prometa",
            "clickhouseHostAllowlist": "clickhouse.services.ocp-lab.prometa.ai",
            "authTrustHost": "true"
          },
          "llm": {
            "defaultProvider": "inference-engine",
            "defaultModel": "orchestra-reference-cpu",
            "inferenceEngineBaseUrl": "https://orchestra-model-plane.orchestra-model.svc.cluster.local:8080"
          },
          "agentQuerying": { "enabled": false },
          "toolExecution": { "enabled": false },
          "releaseValidation": { "enabled": false },
          "modelPlane": { "enabled": false },
          "evalModel": { "enabled": false },
          "nats": { "enabled": false },
          "eventBus": {
            "externalJetStream": {
              "enabled": true,
              "existingSecret": "orchestra-platform-jetstream",
              "urlKey": "nats-url",
              "streamReplicas": 3,
              "auth": {
                "mode": "userpass",
                "usernameKey": "username",
                "passwordKey": "password",
                "tokenKey": "token"
              },
              "tls": { "required": true },
              "connection": {
                "timeoutMs": 10000,
                "maxReconnectAttempts": 60,
                "reconnectWaitMs": 1000
              },
              "networkPolicyEgress": [
                {
                  "to": [
                    { "ipBlock": { "cidr": "10.60.0.0/20" } },
                    { "ipBlock": { "cidr": "10.64.0.0/14" } },
                    { "ipBlock": { "cidr": "10.68.0.0/20" } }
                  ],
                  "ports": [{ "protocol": "TCP", "port": 4222 }]
                }
              ],
              "rolloutId": "release-set-d4b4ef7e"
            }
          },
          "controlPlaneEvents": { "mode": "postgres" },
          "ingest": {
            "rateLimit": {
              "scope": "deployment-shared",
              "shared": {
                "backend": "sentinel",
                "existingSecretName": "orchestra-platform-ingest-rate-limit",
                "sentinelConfigKey": "sentinel-config.json",
                "allowInsecureRedis": false,
                "keyPrefix": "orchestra:reference-lab:ingest",
                "connectTimeoutMs": 1000,
                "operationTimeoutMs": 1000,
                "rolloutId": "release-set-d4b4ef7e",
                "networkPolicyEgress": [
                  {
                    "to": [
                      { "ipBlock": { "cidr": "10.60.0.0/20" } },
                      { "ipBlock": { "cidr": "10.64.0.0/14" } },
                      { "ipBlock": { "cidr": "10.68.0.0/20" } }
                    ],
                    "ports": [{ "protocol": "TCP", "port": 6379 }]
                  }
                ]
              }
            }
          },
          "secret": {
            "create": false,
            "existingSecret": "orchestra-platform-secrets",
            "rolloutId": "release-set-d4b4ef7e",
            "data": {}
          },
          "backendTls": {
            "enabled": true,
            "port": 3443,
            "existingSecret": "orchestra-platform-backend-tls",
            "certificateKey": "tls.crt",
            "privateKeyKey": "tls.key",
            "rolloutId": "release-set-d4b4ef7e",
            "serverName": "orchestra-platform.orchestra-platform.svc",
            "serviceServingCertificate": {
              "enabled": true,
              "caBundleConfigMapName": "orchestra-platform-service-ca"
            }
          },
          "serviceAccount": {
            "create": true,
            "name": "orchestra-platform",
            "automountServiceAccountToken": false
          },
          "podSecurityContext": {},
          "containerSecurityContext": {
            "runAsNonRoot": true,
            "allowPrivilegeEscalation": false,
            "readOnlyRootFilesystem": true,
            "capabilities": { "drop": ["ALL"] },
            "seccompProfile": { "type": "RuntimeDefault" }
          },
          "autoscaling": {
            "enabled": true,
            "minReplicas": 2,
            "maxReplicas": 6,
            "targetCPUUtilizationPercentage": 70
          },
          "podDisruptionBudget": { "enabled": true, "minAvailable": 1 },
          "postgresql": { "enabled": false },
          "clickhouse": { "enabled": false },
          "route": {
            "enabled": true,
            "host": "platform.apps.ocp-lab.prometa.ai",
            "tls": {
              "termination": "reencrypt",
              "insecureEdgeTerminationPolicy": "Redirect"
            }
          },
          "ingress": { "enabled": false },
          "trustedCA": {
            "enabled": true,
            "configMapName": "orchestra-platform-trusted-ca",
            "key": "ca-bundle.crt"
          },
          "migrate": { "enabled": true, "initClickHouse": true },
          "scheduledJobs": {
            "alerts-eval": { "enabled": false },
            "aml-rule": { "enabled": false },
            "aml-judge": { "enabled": false },
            "aql": { "enabled": false },
            "sector-benchmark-snapshot": { "enabled": false },
            "retention-enforce": { "enabled": false },
            "control-plane-events-retention": { "enabled": false },
            "rotate-keys": { "enabled": false },
            "audit-checkpoint": { "enabled": false },
            "guardrail-dispatch": { "enabled": false },
            "release-validation-evaluate": { "enabled": false }
          },
          "networkPolicy": {
            "enabled": true,
            "ingressFrom": [
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "openshift-ingress"
                  }
                }
              },
              {
                "namespaceSelector": {
                  "matchLabels": {
                    "kubernetes.io/metadata.name": "orchestra-synthetic"
                  }
                }
              }
            ],
            "egress": [
              {
                "to": [
                  {
                    "namespaceSelector": {
                      "matchLabels": {
                        "kubernetes.io/metadata.name": "orchestra-model"
                      }
                    }
                  }
                ],
                "ports": [{ "protocol": "TCP", "port": 8080 }]
              },
              {
                "to": [
                  { "ipBlock": { "cidr": "10.60.0.0/20" } },
                  { "ipBlock": { "cidr": "10.64.0.0/14" } },
                  { "ipBlock": { "cidr": "10.68.0.0/20" } }
                ],
                "ports": [
                  { "protocol": "TCP", "port": 443 },
                  { "protocol": "TCP", "port": 5432 },
                  { "protocol": "TCP", "port": 8443 }
                ]
              }
            ]
          },
          "metrics": {
            "serviceMonitor": {
              "enabled": true,
              "interval": "30s",
              "scrapeTimeout": "10s",
              "bearerTokenSecret": {
                "name": "orchestra-platform-secrets",
                "key": "METRICS_SCRAPE_TOKEN"
              }
            }
          },
          "backup": {
            "postgres": { "enabled": false },
            "clickhouse": { "enabled": false }
          },
          "topologySpreadConstraints": [
            {
              "maxSkew": 1,
              "topologyKey": "kubernetes.io/hostname",
              "whenUnsatisfiable": "DoNotSchedule",
              "labelSelector": {
                "matchLabels": {
                  "app.kubernetes.io/component": "app"
                }
              }
            }
          ]
        }
      }
    },
    "destination": {
      "server": "https://kubernetes.default.svc",
      "namespace": "orchestra-platform"
    },
    "syncPolicy": {
      "automated": { "prune": true, "selfHeal": true },
      "syncOptions": [
        "CreateNamespace=false",
        "ServerSideApply=true"
      ],
      "retry": {
        "limit": 3,
        "backoff": {
          "duration": "10s",
          "factor": 2,
          "maxDuration": "3m"
        }
      }
    }
  }
}
